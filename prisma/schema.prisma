// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "linux-musl"]
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id Int  @id @default(autoincrement())
  name String
  fileUUID String @unique
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId Int
  metadata Json? // TODO implement
}

model User {
  id    Int    @id @default(autoincrement())
  username  String @unique
  firstName  String
  lastName  String
  email String @unique
  emailValidated Boolean @default(false)
  userColor String @default("#FFFFFF")
  picture String  
  pictureUpload Upload @relation(fields: [picture], references: [path])
  role Role @default(USER)
  createdAt DateTime @default(now())
  activeAt DateTime @default(now())
  password String?
  authId Json? //googleId
  loginMethod String @default("local")
  occupationType OccupationType @default(None)

  // relations
    projects Project[]
    solves Solve[]
    Guide Guide[] // guides written by user
    Course Course? // course offered 
    Review Review[]
    Upload Upload[] @relation(name: "Upload User")
    Inquiry Inquiry[]
    Problem Problem[]
    Feedback Feedback[]
    JoinedClass StudentsInCourse[] // TODO Change to Enrollment
    CreatedClasses Class[] @relation(name: "ClassToCreator")
    Assigments Assignment[]

}
enum OccupationType {
  None
  Student
  Teacher
}
enum Role {
  USER
  ADMIN
}

model Code {
  code String  @id @unique
  value String
  iat DateTime @default(now())
  exp DateTime @default(now())
}

model RefreshToken {
  code String  @id @unique
  hmac String
  iat DateTime @default(now())
  exp DateTime @default(now())
}

model Guide {
  id Int  @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id])
  authorId Int @default(1)
  positiveRatings Int @default(0)
  negativeRatings Int @default(0)
  content String
  description String?
  category String?
  visits Int @default(0)
  guideTags GuideTag[]
}

model Tag {
  id Int @id @default(autoincrement())
  name String @unique
  guideTags GuideTag[]

  Problem ProblemTag[]
}

model GuideTag {
  guideId Int
  tagId Int
  guide Guide @relation(fields: [guideId], references: [id])
  tag Tag @relation(fields: [tagId], references: [id])

  @@id([guideId, tagId])
}

model ProblemTag {
  problemId Int
  tagId Int
  problem Problem @relation(fields: [problemId], references: [id])
  tag Tag @relation(fields: [tagId], references: [id])
  displayColor String?
  @@id([problemId, tagId])
}

model Problem {
  id Int  @id @default(autoincrement())
  name String 
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  // author String @default("Anonim")
  author User @relation(fields: [authorId], references: [id])
  authorId Int @default(1)
  positiveRatings Int @default(0)
  negativeRatings Int @default(0)
  description String?
  requirement Json? // data in, data out, notes, example, explenation
  tests Json[]
  averageTimeLimit Float
  averageMemLimit Float
  category String?
  sourceCode String?
  difficulty Difficulty?
  tags String[]
  grade Int @default(9)
  tagsLinked ProblemTag[]
  solves Solve[]

  Assignment Assignment[]
}

enum Difficulty {
  Beginner
  Easy
  Medium
  Hard
  Exam
  Competition
}


model Solve {
  id Int @id @default(autoincrement())

  user User @relation(fields: [userId], references: [id])
  userId Int 
  problem Problem  @relation(fields: [problemid], references: [id]) 
  problemid Int
  sourceCode String
  uploadedAt DateTime @default(now())
  score Int
  time Int @default(-1)
}


model Course {
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId], references: [id])
  userId Int  @unique

  experience String
  price Int 
  courseLength Int
  summary String @default("Salut, ofer meditatii la informatica!")
  description String
  summaryPath String?
  videoSummary Upload? @relation(fields: [summaryPath], references: [path])
  phone String?
  external Json?
  email String?
  
  views Int @default(0)
  inquiries Inquiry[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

}

model Inquiry {
  id Int @id @default(autoincrement())
  
  course Course @relation(fields: [courseId], references: [id])
  courseId Int
  user User? @relation(fields: [userId], references: [id])
  userId Int?

  createdAt DateTime @default(now())

  respondedAt DateTime?
  response Boolean?

  contactInfo Json
  message String?

  firstName String
  lastName String
  // @@id([userId, courseId])
}

model Review {
  id Int @id @default(autoincrement())

  user User @relation(fields: [userId], references: [id])
  userId Int
  course Course @relation(fields: [courseId], references: [id])
  courseId Int

  rating Int
  createdAt DateTime @default(now())
  motive String?

  @@unique([userId, courseId])
}

model Upload {
  id Int @unique @default(autoincrement())
  path String @default("default") @unique

  originalName String @default("default")
  size Int @default(0)

  UploadUser User? @relation(name: "Upload User", fields: [UserId], references: [id])
  UserId Int?

  createdAt DateTime @default(now())
  
  Course Course[]
  ProfilePictures User[]

  
}


model Feedback {
  id Int @id @default(autoincrement())

  userId Int?
  user User? @relation(fields: [userId], references: [id])

  body String

  createdAt DateTime @default(now())
}



// classes

model Class {
  id Int @id @default(autoincrement())

  name String
  description String?

  creatorId Int
  Creator User @relation(fields: [creatorId], references: [id], name: "ClassToCreator")
  createdAt DateTime @default(now())
  color String @default("ffffff")

  Students StudentsInCourse[]

  Assignments Assignment[]
}
// TODO Change to Enrollment
model StudentsInCourse {

  userId Int
  User User @relation(fields: [userId], references: [id]) 

  classId Int
  Class Class @relation(fields: [classId], references: [id])

  joinDate DateTime @default(now())


  @@unique([userId, classId])
}


model Assignment {
  id Int @id @default(autoincrement())

  Class Class @relation(fields: [classId], references: [id])
  classId Int

  problemId Int?
  Problem Problem? @relation(fields: [problemId], references: [id])

  title String
  description String?

  createdAt DateTime @default(now())
  dueDate DateTime?

  assignedTo User[]
}