{
    "compilerOptions": {
      "composite": true,       // Required for project references
      "module": "CommonJS",
      "target": "ES2024",
      "declaration": true,
      "declarationMap": true,
      "outDir": "../dist/shared",
      "tsBuildInfoFile": "../dist/shared/.tsbuildinfo",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "noImplicitAny": false

    },
    "include": ["src", "../../public"]
  }