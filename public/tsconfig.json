{
    "compilerOptions": {
      "composite": true,
      "module": "ES2020",
      "target": "ES2024",
      "outDir": "../dist/public",
      "tsBuildInfoFile": "../dist/public/.tsbuildinfo",
      "rootDir": "src",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node10",
      "skipLibCheck": true,
      "noImplicitAny": false,
      "baseUrl": "/dist/public/",
      "paths": {
        "client/modules/*": ["./../../node_modules/*"],
        "client/modules/xterm": ["./../../node_modules/@xterm/xterm/src/browser/Index.d.ts"]
      }
    },
    "include": ["src"],
    "references": [
      { "path": "../shared" }
    ]
  }