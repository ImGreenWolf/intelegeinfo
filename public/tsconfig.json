{
    "compilerOptions": {
      "composite": true,
      "module": "es2022",
      "target": "ES2024",
      "outDir": "../dist/public",
      "tsBuildInfoFile": "../dist/public/.tsbuildinfo",
      "rootDir": "src",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "noImplicitAny": false

    },
    "include": ["src"],
    "references": [
      { "path": "../shared" }
    ]
  }