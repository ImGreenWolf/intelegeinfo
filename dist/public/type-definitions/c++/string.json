{
    "name": "string",
    "namespace": "std",
    "included": ["utility"],
    "description": "The <string> library provides the std::string class and related functions for working with sequences of characters.",
    "members": {},
    "methods": {
        "to_string": {
            "desc": "Converts a numeric value to its string representation.",
            "returnType": "std::string",
            "params": ["int | long | long long | float | double | long double"]
        },
        "stoi": {
