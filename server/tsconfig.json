{
    "compilerOptions": {
      "composite": true,
      "module": "CommonJS",
      "target": "ES2024",
      "outDir": "../dist/server",
      "tsBuildInfoFile": "../dist/server/.tsbuildinfo",
      "rootDir": "./src",
      "strict": false,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true
    },
    "include": ["src"],
    "references": [
      { "path": "../shared" }
    ]
  }